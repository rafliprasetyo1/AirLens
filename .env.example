# Salin ke .env lalu isi:  cp .env.example .env
# .env tidak pernah di-commit. Jangan tempel nilai rahasia ke chat.

# laptop | lab  (Makefile menimpanya lewat PROFILE=...)
APP_PROFILE=laptop

POSTGRES_DB=airlens
POSTGRES_USER=airlens
# WAJIB diganti. Pakai huruf dan angka saja (dipakai di URL koneksi MLflow). Buat dengan: openssl rand -hex 24
POSTGRES_PASSWORD=ganti-dengan-password-acak

# IQAir (pembanding real-time, Fase 4). Paket Community gratis.
IQAIR_API_KEY=

# Sensor Beta (Tahap 2, opsional): bila diisi, node ESP32/simulator wajib mengirim header X-Node-Token dengan nilai ini.
# Kosong = diterima tanpa token (cukup untuk hotspot booth yang tertutup). Buat dengan: openssl rand -hex 16
SENSOR_TOKEN=
# Node lengkap (Tahap 3, opsional): header X-Node-Token untuk POST /api/node/readings. Kosong = tanpa token.
NODE_TOKEN=

# Unduh dataset (Fase 2)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Uji Indonesia (opsional, Fase 2)
OPENAQ_API_KEY=
MAPILLARY_ACCESS_TOKEN=

# LM Studio di Windows (opsional, hanya pembanding zero-shot). Kosongkan bila tidak dipakai -> evaluasi VLM "dilewati".
# Laptop dengan Docker Desktop: http://host.docker.internal:1234/v1 (lihat ENVIRONMENT.md). Lab: hasil Fase 0 di lab.
VLM_BASE_URL=
VLM_MODEL=

# Monitoring (Fase 5, opsional): URL webhook (mis. Slack/Discord) untuk peringatan; kosong = hanya log.
MONITOR_WEBHOOK_URL=

# Web Push (Tahap 4): notifikasi kejadian saat website tertutup. Isi dengan `make vapid-keys` (menulis ke .env ini,
# tidak dicetak). Kosong = notifikasi hanya saat tab website terbuka. VAPID_SUBJECT: mailto: atau https: kontak umum.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Mode pameran (make expo-setup mengisinya 1): SENSOR_TOKEN dan NODE_TOKEN wajib, kiriman tanpa token ditolak.
EXPO_MODE=0
# Diisi otomatis oleh make expo-public: alamat sesi ngrok free (berganti tiap sesi).
NGROK_DOMAIN=
