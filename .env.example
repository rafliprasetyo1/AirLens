# Salin ke .env lalu isi:  cp .env.example .env
# .env tidak pernah di-commit. Jangan tempel nilai rahasia ke chat.

# laptop | lab  (Makefile menimpanya lewat PROFILE=...)
APP_PROFILE=laptop

POSTGRES_DB=airlens
POSTGRES_USER=airlens
# WAJIB diganti. Pakai huruf dan angka saja (dipakai di URL koneksi MLflow). Buat dengan: openssl rand -hex 24
POSTGRES_PASSWORD=ganti-dengan-password-acak

# IQAir (pembanding real-time, Fase 4). Paket Community gratis.
IQAIR_API_KEY=

# Unduh dataset (Fase 2)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Uji Indonesia (opsional, Fase 2)
OPENAQ_API_KEY=
MAPILLARY_ACCESS_TOKEN=

# LM Studio di Windows (opsional, hanya pembanding zero-shot). Kosongkan bila tidak dipakai -> evaluasi VLM "dilewati".
# Laptop dengan Docker Desktop: http://host.docker.internal:1234/v1 (lihat ENVIRONMENT.md). Lab: hasil Fase 0 di lab.
VLM_BASE_URL=
VLM_MODEL=

# Monitoring (Fase 5, opsional): URL webhook (mis. Slack/Discord) untuk peringatan; kosong = hanya log.
MONITOR_WEBHOOK_URL=
